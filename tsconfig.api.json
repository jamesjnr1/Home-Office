{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "skipLibCheck": true,

    // Matches how Vercel actually builds these functions (Node ESM,
    // package.json has "type": "module") — this is what caught the
    // missing ".js" extensions on relative imports that "bundler"
    // resolution silently allowed but Node's real loader rejected.
    "moduleResolution": "NodeNext",
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "types": ["node"],

    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["api"]
}
